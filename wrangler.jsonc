{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aadm-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "vars": {
    "APP_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aadm-db",
      "database_id": "31192c14-7cda-4b9d-855f-5b7e40ea592b",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
